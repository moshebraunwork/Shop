# Copy to .env and edit. .env stays on the server (git ignores it).
APP_PASSWORD='change-me'
CONTAINER_NAME=shopping-list
IMAGE_NAME=shopping-list
# Where to listen. 3000 = every interface; 127.0.0.1:3100 = only this machine (behind a proxy)
PORT_BINDING=3000
# Docker volume that holds db.json
DATA_VOLUME=shopping-list-data
# 1 when behind Caddy/nginx/Cloudflare
TRUST_PROXY=0
